<script>
// ─── KNOWLEDGE BASE ───
const CATEGORIES = {
  "Payment Issue":{
    keywords:["payment","charged","refund","billing","invoice","money","deducted","transaction","fee","overcharged","double charged","failed payment","card","amount"],
    priority:"HIGH",icon:"💳",
    kw_display:["payment","charged","refund","billing","transaction","fee","overcharged"]
  },
  "Technical Error":{
    keywords:["error","not working","crash","bug","broken","fail","unable","cannot","login","password","otp","app","website","slow","freeze","blank","server","down"],
    priority:"HIGH",icon:"⚙️",
    kw_display:["error","crash","bug","login","password","app","server","freeze"]
  },
  "Account Issue":{
    keywords:["account","locked","blocked","suspended","username","verify","hacked","unauthorized","access denied","reset","delete account","deactivate","profile"],
    priority:"MEDIUM",icon:"🔐",
    kw_display:["account","locked","hacked","unauthorized","suspended","reset","verify"]
  },
  "Delivery Delay":{
    keywords:["delay","late","not delivered","shipment","order","delivery","tracking","pending","stuck","dispatch","lost","missing","where is my","not arrived"],
    priority:"MEDIUM",icon:"📦",
    kw_display:["delay","late","not delivered","tracking","pending","stuck","lost"]
  },
  "Product Quality":{
    keywords:["damaged","broken","defective","wrong item","different","quality","replace","return","exchange","warranty","torn","scratched","missing parts","poor quality"],
    priority:"MEDIUM",icon:"🔍",
    kw_display:["damaged","defective","wrong item","replace","return","warranty","poor quality"]
  },
  "General Enquiry":{
    keywords:["how","what","when","where","help","information","guide","steps","policy","terms","question","explain"],
    priority:"LOW",icon:"💬",
    kw_display:["how","what","help","guide","steps","policy","explain"]
  }
};
const RESOLUTION_STEPS={
  "Payment Issue":["Verify the transaction ID and purchase details from the system","Check if payment was debited from customer's account","Raise a refund/correction request in the billing system","Send confirmation email to customer with expected timeline","Follow up within 3–5 business days to confirm resolution"],
  "Technical Error":["Collect details: device type, OS version, app version","Ask customer to clear cache and restart the application","Check server/system status from the admin dashboard","If login issue: send password reset link to registered email","If issue persists: escalate to the technical team with logs"],
  "Account Issue":["Verify customer identity using registered email or phone","Check account status in the admin panel","If hacked: immediately freeze account and alert security team","If locked: unlock after successful identity verification","Send confirmation to customer once account is restored"],
  "Delivery Delay":["Retrieve order number and check real-time tracking status","Contact the logistics/courier partner for update","Provide customer with expected delivery date","If significantly delayed: offer partial refund or priority re-dispatch","Close ticket only after customer confirms delivery"],
  "Product Quality":["Ask customer to share photo/video evidence of the issue","Verify purchase date and check warranty period","Approve replacement order or full refund","Arrange free pickup of the defective product","Dispatch replacement within 2 business days"],
  "General Enquiry":["Identify the exact topic the customer needs help with","Provide clear, step-by-step instructions","Share a help article or FAQ link if available","Confirm whether the response answered the query","Log query for FAQ update if asked frequently"]
};
const ESCALATION_TEAM={"Payment Issue":"Finance & Billing Department","Technical Error":"IT Support Team (Level 2)","Account Issue":"Account Security Team","Delivery Delay":"Logistics & Fulfilment Team","Product Quality":"Quality Assurance Team","General Enquiry":"Customer Support Team"};
const SLA={HIGH:"Response within 2 hours",MEDIUM:"Response within 24 hours",LOW:"Response within 72 hours"};

// ─── NLP ENGINE ───
const STOP=new Set(["i","me","my","we","you","your","he","she","it","they","is","are","was","were","am","be","been","have","has","had","do","does","did","a","an","the","and","but","or","so","at","by","for","in","of","on","to","up","with","from","this","that","these","very","just","also","still","get","hi","hello","dear","sir","madam","please","kindly","thank"]);
const clean=t=>t.toLowerCase().replace(/[^\w\s]/g,' ').replace(/\s+/g,' ').trim();
const scoreCategories=text=>{
  const c=clean(text);
  const tokens=c.split(' ').filter(w=>!STOP.has(w));
  const scores={},kws={};
  for(const[cat,d]of Object.entries(CATEGORIES)){
    let s=0,hits=[];
    for(const kw of d.keywords)if(c.includes(kw)){hits.push(kw);s+=kw.includes(' ')?2:1;}
    scores[cat]=s;kws[cat]=hits;
  }
  return{scores,kws,tokens};
};
const extractEntities=text=>{
  const f={};
  const o=text.match(/\b(?:order|ord|ref)[:\-#]?\s*\d{4,12}\b/gi);if(o)f["Order ID"]=o;
  const a=text.match(/(?:rs\.?|rupees?|inr|₹)\s*[\d,]+|\b\d+\s*rupees?\b/gi);if(a)f["Amount"]=a;
  const e=text.match(/\b[\w.+-]+@[\w-]+\.[a-z]{2,}\b/g);if(e)f["Email"]=e;
  const p=text.match(/\b[6-9]\d{9}\b/g);if(p)f["Phone"]=p;
  return f;
};
const detectSentiment=text=>{
  const t=text.toLowerCase();
  if(["angry","frustrated","ridiculous","unacceptable","worst","terrible","cheated","fraud","scam","horrible"].some(w=>t.includes(w)))return["ANGRY",0.05];
  if(["urgent","immediately","asap","emergency","right now","cannot wait","critical","serious"].some(w=>t.includes(w)))return["URGENT",0.03];
  return["NEUTRAL",0.0];
};
const calcCF=(s,m)=>m?+Math.min(s/m,1).toFixed(2):0;
const combineCF=(a,b)=>+((a+b*(1-a)).toFixed(2));
const cfLabel=cf=>cf>=0.85?"VERY HIGH":cf>=0.65?"HIGH":cf>=0.45?"MODERATE":cf>=0.25?"LOW":"VERY LOW";
const escalation=(cf,pri,sent)=>{
  if(cf<0.40)return[true,"Low confidence — system is unsure, human review needed"];
  if(sent==="ANGRY"&&pri==="HIGH")return[true,"Angry customer with high-priority issue — human empathy needed"];
  if(pri==="HIGH"&&cf<0.60)return[true,"High-priority but moderate confidence — verify with agent"];
  return[false,"Automated resolution is sufficient"];
};

function analyse(complaint){
  const{scores,kws,tokens}=scoreCategories(complaint);
  const entities=extractEntities(complaint);
  const[sent,boost]=detectSentiment(complaint);
  const maxScore=Math.max(...Object.values(scores));
  let cat="General Enquiry",baseCF=0.20;
  if(maxScore>0){
    cat=Object.keys(scores).reduce((a,b)=>scores[a]>scores[b]?a:b);
    baseCF=calcCF(scores[cat],maxScore);
  }
  const ruleCF=scores[cat]>=3?0.85:scores[cat]>=1?0.65:0.30;
  const combined=+Math.min((combineCF(baseCF,ruleCF)+boost).toFixed(2),1.0);
  const pri=CATEGORIES[cat].priority;
  const[esc,escReason]=escalation(combined,pri,sent);
  return{
    complaint,wordCount:complaint.trim().split(/\s+/).length,
    cat,icon:CATEGORIES[cat].icon,pri,sent,
    allScores:scores,matchedKws:kws[cat],
    baseCF,ruleCF,combined,confidence:cfLabel(combined),
    steps:RESOLUTION_STEPS[cat],escalateTo:ESCALATION_TEAM[cat],
    sla:SLA[pri],esc,escReason,entities
  };
}

// ─── SESSION ───
let log=[];

// ─── RENDER CATEGORIES GRID ───
(function renderCatGrid(){
  const g=document.getElementById('cat-grid');
  for(const[name,d]of Object.entries(CATEGORIES)){
    g.innerHTML+=`<div class="cat-card">
      <div class="cat-card-icon">${d.icon}</div>
      <div class="cat-card-name">${name}</div>
      <div><span class="cat-card-priority priority-${d.priority}">${d.priority}</span></div>
      <div class="cat-card-sla">${SLA[d.priority]}</div>
      <div class="cat-card-kws">${d.kw_display.join(' · ')}</div>
    </div>`;
  }
})();

// ─── UI HELPERS ───
function scrollToAnalyser(){document.getElementById('analyser').scrollIntoView({behavior:'smooth'})}
function updateWordCount(ta){
  const w=ta.value.trim()?ta.value.trim().split(/\s+/).length:0;
  document.getElementById('word-counter').textContent=w+' word'+(w===1?'':'s');
}
function loadSample(el){
  const text=el.querySelector('div:last-child').textContent.trim();
  document.getElementById('complaint-input').value=text;
  updateWordCount(document.getElementById('complaint-input'));
}
function clearAll(){
  document.getElementById('complaint-input').value='';
  document.getElementById('word-counter').textContent='0 words';
  document.getElementById('state-empty').style.display='flex';
  document.getElementById('state-loading').style.display='none';
  document.getElementById('result-area').style.display='none';
}
function clearHistory(){
  log=[];
  document.getElementById('history-section').classList.remove('visible');
  document.getElementById('stats-section').classList.remove('visible');
  document.getElementById('history-tbody').innerHTML='';
}

function showLoading(){
  document.getElementById('state-empty').style.display='none';
  document.getElementById('state-loading').style.display='flex';
  document.getElementById('result-area').style.display='none';
}
function showResult(r){
  document.getElementById('state-empty').style.display='none';
  document.getElementById('state-loading').style.display='none';
  const ra=document.getElementById('result-area');
  ra.style.display='block';
  ra.innerHTML=renderResult(r);
  setTimeout(()=>{
    const max=Math.max(...Object.values(r.allScores));
    document.querySelectorAll('[data-score]').forEach(b=>{
      const s=+b.dataset.score;
      b.style.width=(max>0?(s/max*100):0)+'%';
    });
  },100);
}

function renderResult(r){
  const sorted=Object.entries(r.allScores).sort((a,b)=>b[1]-a[1]);
  const max=Math.max(...Object.values(r.allScores));

  const scoresHtml=sorted.map(([cat,score])=>{
    const cf=calcCF(score,max);
    const win=cat===r.cat;
    return`<div class="cf-row">
      <div class="cf-name${win?' winner':''}">${cat}</div>
      <div class="cf-track"><div class="cf-fill${win?' winner':''}" data-score="${score}"></div></div>
      <div class="cf-num${win?' winner':''}">${cf.toFixed(2)}</div>
    </div>`;
  }).join('');

  const kwHtml=r.matchedKws.length
    ?`<div class="kw-cloud">${r.matchedKws.map(k=>`<span class="kw-tag">${k}</span>`).join('')}</div>`
    :`<div style="padding:1rem 1.2rem;font-size:0.8rem;color:var(--dim)">No specific keywords matched.</div>`;

  const entHtml=Object.entries(r.entities).map(([k,v])=>
    `<div class="r-meta-item"><div class="r-meta-key">${k}</div><div class="r-meta-val">${v.join(', ')}</div></div>`
  ).join('');

  const chainItems=[
    `Complaint received — ${r.wordCount} word${r.wordCount===1?'':'s'} analysed.`,
    `NLP tokenisation complete. Keywords matched category: <strong>${r.cat}</strong>`,
    `Base CF calculated: score=${r.allScores[r.cat]}, max=${Math.max(...Object.values(r.allScores))}, baseCF = <strong>${r.baseCF.toFixed(2)}</strong>`,
    `Rule-based CF applied: score≥3 → 0.85, score≥1 → 0.65, else → 0.30. RuleCF = <strong>${r.ruleCF.toFixed(2)}</strong>`,
    `MYCIN formula: ${r.baseCF} + ${r.ruleCF} × (1 − ${r.baseCF}) = <strong>${combineCF(r.baseCF,r.ruleCF).toFixed(2)}</strong>`,
    `Sentiment detected: <strong>${r.sent}</strong>${r.sent!=='NEUTRAL'?' → CF boosted':''}`,
    `Final Combined CF = <strong>${r.combined.toFixed(2)}</strong> → ${r.confidence} CONFIDENCE`,
    `Priority: <strong>${r.pri}</strong> — SLA: ${r.sla}`,
    `Escalation decision: <strong>${r.esc?'YES — Human Agent Required':'NO — Automated Resolution'}</strong>`
  ];

  const escalHtml=r.esc
    ?`<div class="r-escalation"><div class="r-esc-head">⚠ Escalation Required</div><div class="r-esc-body">${r.escReason}<br><br>Assign immediately to: <strong>${r.escalateTo}</strong></div></div>`
    :`<div class="r-resolved">✓ &nbsp;Automated Resolution Sufficient — No Escalation Needed &nbsp;|&nbsp; ${r.escalateTo} on standby</div>`;

  return`<div class="result">
    <div class="r-category">
      <div class="r-cat-left">
        <div class="r-cat-eyebrow">Classified Category</div>
        <div class="r-cat-name">${r.icon} ${r.cat}</div>
        <div class="r-cat-sla">${r.sla}</div>
      </div>
      <div class="r-cat-right">
        <div class="r-priority">${r.pri}</div>
        <div class="r-cf-big">${r.combined.toFixed(2)}</div>
        <div class="r-cf-label">Combined CF</div>
      </div>
    </div>

    <div class="r-block">
      <div class="r-block-head"><span>CF Scores — All Categories</span><span>MYCIN Certainty Factor</span></div>
      <div class="r-block-body"><div class="cf-rows">${scoresHtml}</div></div>
    </div>

    <div class="r-meta">
      <div class="r-meta-item"><div class="r-meta-key">Confidence Level</div><div class="r-meta-val">${r.confidence}</div></div>
      <div class="r-meta-item"><div class="r-meta-key">Sentiment</div><div class="r-meta-val">${r.sent}</div></div>
      <div class="r-meta-item"><div class="r-meta-key">Escalate To</div><div class="r-meta-val">${r.escalateTo}</div></div>
      <div class="r-meta-item"><div class="r-meta-key">Word Count</div><div class="r-meta-val">${r.wordCount} words</div></div>
      ${entHtml}
    </div>

    <div class="r-block">
      <div class="r-block-head"><span>Matched Keywords</span><span>${r.matchedKws.length} matches</span></div>
      ${kwHtml}
    </div>

    <div class="r-block">
      <div class="r-block-head"><span>Reasoning Chain</span><span>9 Steps</span></div>
      <div class="chain-steps">
        ${chainItems.map((s,i)=>`<div class="chain-step"><div class="chain-n">${String(i+1).padStart(2,'0')}</div><div class="chain-t">${s}</div></div>`).join('')}
      </div>
    </div>

    <div class="r-block">
      <div class="r-block-head"><span>Resolution Path</span><span>${r.cat}</span></div>
      <ul class="res-list">
        ${r.steps.map(s=>`<li class="res-item"><span class="res-arrow">→</span><span class="res-text">${s}</span></li>`).join('')}
      </ul>
    </div>

    ${escalHtml}
  </div>`;
}

// ─── MAIN ANALYSE ───
async function analyseComplaint(){
  const text=document.getElementById('complaint-input').value.trim();
  if(!text){alert('Please enter a complaint first.');return;}
  const btn=document.getElementById('analyse-btn');
  btn.disabled=true;
  showLoading();
  await new Promise(r=>setTimeout(r,700));
  const r=analyse(text);
  log.push({...r,time:new Date()});
  showResult(r);
  updateHistory();
  updateStats();
  btn.disabled=false;
  document.getElementById('result-area').scrollIntoView({behavior:'smooth',block:'start'});
}

// ─── DEMO ───
const DEMOS=[
  "I was charged twice for order ORD-7821. Please refund Rs. 1500 immediately.",
  "The app keeps crashing every time I try to login. Very frustrated and angry!",
  "My account has been hacked and there are suspicious transactions I did not make.",
  "My delivery is 3 weeks late. Order ORD-984521 still shows pending status. Urgent!",
  "I received a completely damaged and wrong product in the box. Poor quality packaging.",
  "Can you help explain how to reset my password? What are the steps?"
];
let demoIdx=0;
async function runDemo(){
  if(demoIdx>=DEMOS.length)demoIdx=0;
  document.getElementById('complaint-input').value=DEMOS[demoIdx++];
  updateWordCount(document.getElementById('complaint-input'));
  scrollToAnalyser();
  setTimeout(analyseComplaint,300);
}
async function runAllDemo(){
  demoIdx=0;
  scrollToAnalyser();
  for(let i=0;i<DEMOS.length;i++){
    await new Promise(r=>setTimeout(r,200));
    document.getElementById('complaint-input').value=DEMOS[demoIdx++];
    updateWordCount(document.getElementById('complaint-input'));
    await analyseComplaint();
    await new Promise(r=>setTimeout(r,400));
  }
}

// ─── HISTORY ───
function updateHistory(){
  document.getElementById('history-section').classList.add('visible');
  const tb=document.getElementById('history-tbody');
  tb.innerHTML='';
  [...log].reverse().forEach((r,i)=>{
    const idx=log.length-i;
    const t=r.time;
    const timeStr=`${t.getHours().toString().padStart(2,'0')}:${t.getMinutes().toString().padStart(2,'0')}:${t.getSeconds().toString().padStart(2,'0')}`;
    tb.innerHTML+=`<tr>
      <td><span class="h-time">${idx}</span></td>
      <td><span class="h-complaint">${r.complaint}</span></td>
      <td class="h-category">${r.icon} ${r.cat}</td>
      <td><span class="h-pri priority-${r.pri}">${r.pri}</span></td>
      <td class="h-cf">${r.combined.toFixed(2)}</td>
      <td class="h-cf">${r.confidence}</td>
      <td class="h-esc${r.esc?' yes':''}">${r.esc?'⚠ YES':'✓ NO'}</td>
      <td class="h-time">${timeStr}</td>
    </tr>`;
  });
}

// ─── STATS ───
function updateStats(){
  document.getElementById('stats-section').classList.add('visible');
  const n=log.length;
  const avgCF=(log.reduce((s,r)=>s+r.combined,0)/n).toFixed(2);
  const esc=log.filter(r=>r.esc).length;
  const auto=n-esc;
  const highConf=log.filter(r=>r.combined>=0.65).length;

  document.getElementById('stats-top').innerHTML=`
    <div class="stat-tile"><div class="st-num">${n}</div><div class="st-label">Complaints Analysed</div></div>
    <div class="stat-tile"><div class="st-num">${avgCF}</div><div class="st-label">Average CF Score</div></div>
    <div class="stat-tile"><div class="st-num">${esc}</div><div class="st-label">Escalated Cases</div></div>
    <div class="stat-tile"><div class="st-num">${auto}</div><div class="st-label">Auto-Resolved</div></div>
    <div class="stat-tile"><div class="st-num">${highConf}</div><div class="st-label">High Confidence</div></div>
  `;

  const byPri={HIGH:0,MEDIUM:0,LOW:0};
  log.forEach(r=>byPri[r.pri]++);
  document.getElementById('priority-bars').innerHTML=
    ['HIGH','MEDIUM','LOW'].map(p=>`
      <div class="pb-row">
        <div class="pb-label">${p}</div>
        <div class="pb-track"><div class="pb-fill${p==='MEDIUM'?' med':p==='LOW'?' low':''}" style="width:${n?byPri[p]/n*100:0}%"></div></div>
        <div class="pb-count">${byPri[p]}</div>
      </div>`).join('');

  const byCat={};
  log.forEach(r=>{byCat[r.cat]=(byCat[r.cat]||0)+1;});
  document.getElementById('cat-stats-list').innerHTML=
    Object.entries(byCat).sort((a,b)=>b[1]-a[1]).map(([cat,count])=>
      `<div class="cs-row">
        <span class="cs-name">${CATEGORIES[cat].icon} ${cat}</span>
        <span class="cs-count">${count} complaint${count>1?'s':''}</span>
      </div>`).join('');
}
</script>
