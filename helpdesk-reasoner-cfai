<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Helpdesk Reasoner — AI Complaint Analysis System</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,300;0,400;0,500;1,400&family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,300&display=swap" rel="stylesheet"/>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --ink:#080808;
  --paper:#f4f4ef;
  --paper-dark:#ebebе5;
  --rule:#d4d4cc;
  --rule-heavy:#2a2a25;
  --muted:#828278;
  --dim:#b4b4ac;
  --lift:#e0e0d8;
  --mono:'DM Mono',monospace;
  --serif:'Playfair Display',serif;
  --sans:'DM Sans',sans-serif;
}
html{scroll-behavior:smooth}
body{background:var(--paper);color:var(--ink);font-family:var(--sans);font-weight:300;line-height:1.65;overflow-x:hidden}

/* ═══════════════════════════════════════════
   SCROLLBAR
═══════════════════════════════════════════ */
::-webkit-scrollbar{width:6px}
::-webkit-scrollbar-track{background:var(--paper)}
::-webkit-scrollbar-thumb{background:var(--dim)}

/* ═══════════════════════════════════════════
   HEADER
═══════════════════════════════════════════ */
header{
  position:sticky;top:0;z-index:200;
  background:var(--paper);
  border-bottom:1px solid var(--rule);
  display:flex;align-items:center;justify-content:space-between;
  padding:0 4rem;height:68px;
}
.logo{
  font-family:var(--mono);font-size:0.75rem;font-weight:500;
  letter-spacing:0.16em;text-transform:uppercase;
  display:flex;align-items:center;gap:0.6rem;
}
.logo-dot{width:7px;height:7px;background:var(--ink);border-radius:50%;animation:pulse 2.4s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:0.4;transform:scale(0.7)}}
nav{display:flex;align-items:center;gap:2.5rem}
nav a{font-family:var(--mono);font-size:0.72rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);text-decoration:none;transition:color 0.2s}
nav a:hover{color:var(--ink)}
.nav-cta{
  font-family:var(--mono);font-size:0.72rem;letter-spacing:0.1em;text-transform:uppercase;
  background:var(--ink);color:var(--paper);border:none;
  padding:0.55rem 1.2rem;cursor:pointer;transition:background 0.15s;font-weight:500;
}
.nav-cta:hover{background:var(--rule-heavy)}

/* ═══════════════════════════════════════════
   HERO
═══════════════════════════════════════════ */
.hero{
  padding:7rem 4rem 5rem;
  border-bottom:1px solid var(--rule);
  display:grid;grid-template-columns:3fr 2fr;gap:5rem;align-items:center;
  position:relative;overflow:hidden;
}
.hero::before{
  content:'';position:absolute;right:-10rem;top:-10rem;
  width:40rem;height:40rem;
  border-radius:50%;border:1px solid var(--rule);opacity:0.5;
  pointer-events:none;
}
.hero::after{
  content:'';position:absolute;right:-6rem;top:-6rem;
  width:30rem;height:30rem;
  border-radius:50%;border:1px solid var(--rule);opacity:0.3;
  pointer-events:none;
}
.hero-tag{
  font-family:var(--mono);font-size:0.68rem;letter-spacing:0.18em;text-transform:uppercase;
  color:var(--muted);margin-bottom:1.8rem;
  display:flex;align-items:center;gap:0.8rem;
}
.hero-tag::before{content:'';width:2rem;height:1px;background:var(--muted)}
.hero h1{
  font-family:var(--serif);font-size:clamp(3rem,5.5vw,5.5rem);
  font-weight:900;line-height:1.02;letter-spacing:-0.025em;
  margin-bottom:2rem;
}
.hero h1 em{font-style:italic;color:var(--muted)}
.hero-desc{
  font-size:1.05rem;color:var(--muted);line-height:1.8;
  max-width:42ch;margin-bottom:2.5rem;
}
.hero-actions{display:flex;gap:1rem;flex-wrap:wrap}
.btn{
  font-family:var(--mono);font-size:0.75rem;letter-spacing:0.08em;text-transform:uppercase;
  padding:0.9rem 2rem;border:none;cursor:pointer;transition:all 0.15s;font-weight:500;
}
.btn-primary{background:var(--ink);color:var(--paper)}
.btn-primary:hover{background:var(--rule-heavy)}
.btn-primary:disabled{background:var(--dim);cursor:not-allowed}
.btn-outline{background:transparent;color:var(--ink);border:1px solid var(--rule-heavy)}
.btn-outline:hover{background:var(--ink);color:var(--paper)}
.btn-ghost{background:transparent;color:var(--muted);border:1px solid var(--rule)}
.btn-ghost:hover{background:var(--lift)}

.hero-right{display:flex;flex-direction:column;gap:0.85rem}
.metric-card{
  border:1px solid var(--rule);padding:1.5rem;
  display:flex;align-items:center;justify-content:space-between;
  transition:border-color 0.2s;
}
.metric-card:hover{border-color:var(--ink)}
.metric-val{font-family:var(--serif);font-size:2.2rem;font-weight:700;line-height:1}
.metric-label{font-family:var(--mono);font-size:0.65rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);margin-top:0.3rem}
.metric-icon{font-size:1.5rem;opacity:0.25}

/* ═══════════════════════════════════════════
   TECH STRIP
═══════════════════════════════════════════ */
.tech-strip{
  border-bottom:1px solid var(--rule);
  padding:1.2rem 4rem;
  display:flex;align-items:center;gap:3rem;overflow:hidden;
}
.tech-item{
  font-family:var(--mono);font-size:0.65rem;letter-spacing:0.12em;text-transform:uppercase;
  color:var(--dim);white-space:nowrap;
  display:flex;align-items:center;gap:0.5rem;
}
.tech-item::before{content:'◆';font-size:0.4rem;color:var(--dim)}

/* ═══════════════════════════════════════════
   HOW IT WORKS SECTION
═══════════════════════════════════════════ */
.section{padding:5rem 4rem;border-bottom:1px solid var(--rule)}
.section-header{
  display:flex;align-items:flex-end;justify-content:space-between;
  margin-bottom:3.5rem;
}
.section-tag{
  font-family:var(--mono);font-size:0.65rem;letter-spacing:0.18em;text-transform:uppercase;
  color:var(--muted);margin-bottom:0.75rem;
}
.section-title{font-family:var(--serif);font-size:clamp(1.8rem,3vw,2.8rem);font-weight:700;line-height:1.15;letter-spacing:-0.01em}
.section-title em{font-style:italic;color:var(--muted)}
.section-subtitle{font-size:0.9rem;color:var(--muted);max-width:30ch;text-align:right;line-height:1.7}

.pipeline{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border:1px solid var(--rule)}
.pipe-step{
  padding:2rem;border-right:1px solid var(--rule);position:relative;
  transition:background 0.2s;
}
.pipe-step:last-child{border-right:none}
.pipe-step:hover{background:var(--lift)}
.pipe-arrow{
  position:absolute;right:-1px;top:50%;transform:translateY(-50%);
  width:0;height:0;border-top:8px solid transparent;border-bottom:8px solid transparent;
  border-left:8px solid var(--rule);z-index:1;
}
.pipe-step:last-child .pipe-arrow{display:none}
.pipe-num{
  font-family:var(--mono);font-size:0.65rem;letter-spacing:0.15em;color:var(--muted);
  margin-bottom:1rem;
}
.pipe-name{font-family:var(--serif);font-size:1.3rem;font-weight:700;margin-bottom:0.6rem}
.pipe-desc{font-size:0.82rem;color:var(--muted);line-height:1.65}
.pipe-tech{
  margin-top:1rem;font-family:var(--mono);font-size:0.62rem;letter-spacing:0.08em;
  text-transform:uppercase;color:var(--dim);
  border-top:1px solid var(--rule);padding-top:0.75rem;
}

/* Categories grid */
.categories-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--rule);border:1px solid var(--rule)}
.cat-card{
  background:var(--paper);padding:1.8rem 1.5rem;
  transition:background 0.2s;cursor:default;
}
.cat-card:hover{background:var(--lift)}
.cat-card-icon{font-size:1.6rem;margin-bottom:0.75rem}
.cat-card-name{font-family:var(--serif);font-size:1.1rem;font-weight:700;margin-bottom:0.4rem}
.cat-card-priority{
  display:inline-block;font-family:var(--mono);font-size:0.58rem;letter-spacing:0.1em;text-transform:uppercase;
  padding:0.2rem 0.5rem;margin-bottom:0.75rem;
}
.priority-HIGH{background:var(--ink);color:var(--paper)}
.priority-MEDIUM{background:var(--muted);color:var(--paper)}
.priority-LOW{background:var(--lift);color:var(--muted);border:1px solid var(--rule)}
.cat-card-sla{font-family:var(--mono);font-size:0.68rem;color:var(--muted);margin-bottom:0.75rem}
.cat-card-kws{font-size:0.75rem;color:var(--dim);line-height:1.6}

/* ═══════════════════════════════════════════
   ANALYSER SECTION (MAIN TOOL)
═══════════════════════════════════════════ */
#analyser{padding:0;border-bottom:1px solid var(--rule)}
.analyser-header{
  padding:3rem 4rem 2rem;border-bottom:1px solid var(--rule);
  display:flex;align-items:center;justify-content:space-between;
}
.analyser-title-group{}
.analyser-actions{display:flex;gap:0.75rem}

.analyser-body{display:grid;grid-template-columns:1fr 1fr;min-height:700px}
.panel-l{
  padding:2.5rem;border-right:1px solid var(--rule);
  display:flex;flex-direction:column;gap:1.5rem;
}
.panel-r{
  padding:2.5rem;display:flex;flex-direction:column;gap:1.5rem;min-height:700px;
}

.panel-label{
  font-family:var(--mono);font-size:0.65rem;letter-spacing:0.18em;text-transform:uppercase;
  color:var(--muted);display:flex;align-items:center;gap:0.75rem;
}
.panel-label::after{content:'';flex:1;height:1px;background:var(--rule)}

textarea{
  width:100%;background:var(--ink);color:var(--paper);border:none;border-radius:0;
  padding:1.75rem;font-family:var(--mono);font-size:0.9rem;line-height:1.75;
  resize:none;height:220px;outline:none;caret-color:var(--paper);
  transition:box-shadow 0.2s;
}
textarea::placeholder{color:#555550}
textarea:focus{box-shadow:0 0 0 1px var(--muted)}

.word-counter{
  font-family:var(--mono);font-size:0.68rem;color:var(--muted);
  text-align:right;margin-top:-0.75rem;
}

.samples-label{
  font-family:var(--mono);font-size:0.62rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--muted);
  margin-bottom:0.6rem;
}
.samples-grid{display:flex;flex-direction:column;gap:0.4rem}
.sample-chip{
  font-size:0.82rem;color:var(--rule-heavy);padding:0.65rem 0.9rem;
  border:1px solid var(--rule);cursor:pointer;transition:all 0.15s;line-height:1.4;
  display:flex;align-items:flex-start;gap:0.6rem;
}
.sample-chip:hover{background:var(--ink);color:var(--paper);border-color:var(--ink)}
.sample-cat{
  font-family:var(--mono);font-size:0.58rem;letter-spacing:0.08em;text-transform:uppercase;
  color:var(--muted);white-space:nowrap;margin-top:0.15rem;min-width:4.5rem;
}
.sample-chip:hover .sample-cat{color:var(--dim)}

/* empty / loading / result states */
.state-empty,.state-loading{
  flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;
  text-align:center;gap:1.25rem;color:var(--dim);
}
.empty-glyph{
  font-family:var(--serif);font-size:5rem;font-weight:700;line-height:1;
  color:var(--rule);letter-spacing:-0.05em;
  animation:float 3s ease-in-out infinite;
}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
.empty-label{font-family:var(--mono);font-size:0.72rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--dim)}

.spinner{
  width:36px;height:36px;border:2px solid var(--rule);border-top-color:var(--ink);
  border-radius:50%;animation:spin 0.8s linear infinite;
}
@keyframes spin{to{transform:rotate(360deg)}}
.loading-label{font-family:var(--mono);font-size:0.72rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--muted)}
.loading-steps{
  font-family:var(--mono);font-size:0.65rem;color:var(--dim);
  display:flex;flex-direction:column;gap:0.3rem;
}

/* result card */
.result{display:flex;flex-direction:column;gap:1.25rem}

.r-category{
  background:var(--ink);color:var(--paper);padding:1.75rem;
  display:flex;align-items:flex-start;justify-content:space-between;
}
.r-cat-left{}
.r-cat-eyebrow{font-family:var(--mono);font-size:0.62rem;letter-spacing:0.15em;text-transform:uppercase;opacity:0.5;margin-bottom:0.4rem}
.r-cat-name{font-family:var(--serif);font-size:1.9rem;font-weight:700;line-height:1.1}
.r-cat-sla{font-family:var(--mono);font-size:0.72rem;opacity:0.5;margin-top:0.5rem}
.r-cat-right{display:flex;flex-direction:column;align-items:flex-end;gap:0.5rem}
.r-priority{
  font-family:var(--mono);font-size:0.65rem;letter-spacing:0.1em;text-transform:uppercase;
  padding:0.3rem 0.75rem;border:1px solid rgba(255,255,255,0.3);font-weight:500;
}
.r-cf-big{font-family:var(--serif);font-size:2.5rem;font-weight:700;line-height:1}
.r-cf-label{font-family:var(--mono);font-size:0.6rem;letter-spacing:0.1em;opacity:0.5;text-align:right}

.r-block{border:1px solid var(--rule);overflow:hidden}
.r-block-head{
  background:var(--lift);padding:0.7rem 1.2rem;
  font-family:var(--mono);font-size:0.62rem;letter-spacing:0.14em;text-transform:uppercase;
  color:var(--muted);border-bottom:1px solid var(--rule);
  display:flex;align-items:center;justify-content:space-between;
}
.r-block-body{padding:1.2rem}

/* cf score bars */
.cf-rows{display:flex;flex-direction:column;gap:0.65rem}
.cf-row{display:grid;grid-template-columns:9.5rem 1fr 3.2rem;align-items:center;gap:0.75rem}
.cf-name{font-size:0.78rem;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cf-name.winner{color:var(--ink);font-weight:600}
.cf-track{height:4px;background:var(--rule);position:relative;overflow:hidden}
.cf-fill{height:100%;background:var(--dim);transition:width 0.7s cubic-bezier(0.4,0,0.2,1);position:absolute;left:0;top:0;width:0}
.cf-fill.winner{background:var(--ink)}
.cf-num{font-family:var(--mono);font-size:0.68rem;color:var(--dim);text-align:right}
.cf-num.winner{color:var(--ink)}

/* meta 2-col */
.r-meta{display:grid;grid-template-columns:1fr 1fr;gap:0.75rem}
.r-meta-item{border:1px solid var(--rule);padding:0.9rem 1rem}
.r-meta-key{font-family:var(--mono);font-size:0.6rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);margin-bottom:0.25rem}
.r-meta-val{font-size:0.85rem;font-weight:500;line-height:1.35}

/* keywords cloud */
.kw-cloud{display:flex;flex-wrap:wrap;gap:0.4rem;padding:1rem 1.2rem}
.kw-tag{
  font-family:var(--mono);font-size:0.68rem;letter-spacing:0.05em;
  padding:0.25rem 0.55rem;background:var(--lift);border:1px solid var(--rule);color:var(--rule-heavy);
}

/* reasoning chain */
.chain-steps{display:flex;flex-direction:column;padding:1.2rem;gap:0}
.chain-step{
  display:grid;grid-template-columns:2rem 1fr;gap:0.75rem;
  padding:0.65rem 0;border-bottom:1px solid var(--rule);
}
.chain-step:last-child{border-bottom:none;padding-bottom:0}
.chain-step:first-child{padding-top:0}
.chain-n{font-family:var(--mono);font-size:0.62rem;color:var(--dim);margin-top:0.2rem}
.chain-t{font-size:0.82rem;color:var(--rule-heavy);line-height:1.55}

/* resolution steps */
.res-list{list-style:none;display:flex;flex-direction:column;gap:0;padding:1.2rem}
.res-item{
  display:flex;gap:0.75rem;padding:0.7rem 0;
  border-bottom:1px solid var(--rule);
}
.res-item:last-child{border-bottom:none;padding-bottom:0}
.res-item:first-child{padding-top:0}
.res-arrow{color:var(--dim);font-family:var(--mono);font-size:0.8rem;flex-shrink:0;margin-top:0.08rem}
.res-text{font-size:0.83rem;color:var(--rule-heavy);line-height:1.55}

/* escalation */
.r-escalation{padding:1.25rem 1.5rem;border:2px solid var(--ink);background:var(--ink);color:var(--paper)}
.r-esc-head{font-family:var(--mono);font-size:0.62rem;letter-spacing:0.15em;text-transform:uppercase;opacity:0.5;margin-bottom:0.5rem}
.r-esc-body{font-size:0.88rem;line-height:1.6}
.r-esc-body strong{font-weight:600}
.r-resolved{padding:1rem 1.25rem;border:1px solid var(--rule);font-family:var(--mono);font-size:0.72rem;letter-spacing:0.06em;color:var(--muted)}

/* ═══════════════════════════════════════════
   HISTORY TABLE
═══════════════════════════════════════════ */
#history-section{display:none;padding:5rem 4rem;border-bottom:1px solid var(--rule)}
#history-section.visible{display:block}
.history-table{width:100%;border-collapse:collapse;border:1px solid var(--rule)}
.history-table th{
  font-family:var(--mono);font-size:0.62rem;letter-spacing:0.12em;text-transform:uppercase;
  color:var(--muted);padding:0.9rem 1.1rem;text-align:left;
  border-bottom:1px solid var(--rule);background:var(--lift);
  border-right:1px solid var(--rule);
}
.history-table th:last-child{border-right:none}
.history-table td{
  padding:0.85rem 1.1rem;font-size:0.82rem;border-bottom:1px solid var(--rule);
  border-right:1px solid var(--rule);vertical-align:top;
}
.history-table td:last-child{border-right:none}
.history-table tr:last-child td{border-bottom:none}
.history-table tr:hover td{background:var(--lift)}
.h-complaint{color:var(--rule-heavy);max-width:18rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.h-category{font-weight:500}
.h-cf{font-family:var(--mono);font-size:0.78rem}
.h-pri{font-family:var(--mono);font-size:0.62rem;letter-spacing:0.08em;text-transform:uppercase;padding:0.2rem 0.5rem;display:inline-block}
.h-esc{font-family:var(--mono);font-size:0.72rem;color:var(--muted)}
.h-esc.yes{color:var(--ink);font-weight:600}
.h-time{font-family:var(--mono);font-size:0.68rem;color:var(--dim)}

/* ═══════════════════════════════════════════
   STATS SECTION
═══════════════════════════════════════════ */
#stats-section{display:none;padding:5rem 4rem;border-bottom:1px solid var(--rule)}
#stats-section.visible{display:block}
.stats-top{display:grid;grid-template-columns:repeat(5,1fr);gap:1px;background:var(--rule);border:1px solid var(--rule);margin-bottom:3rem}
.stat-tile{
  background:var(--paper);padding:2rem 1.5rem;
  transition:background 0.2s;
}
.stat-tile:hover{background:var(--lift)}
.st-num{font-family:var(--serif);font-size:2.8rem;font-weight:700;line-height:1;margin-bottom:0.3rem}
.st-label{font-family:var(--mono);font-size:0.62rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted)}

.stats-bottom{display:grid;grid-template-columns:1fr 1fr;gap:2rem}

/* donut-style chart replacement: horizontal bars */
.priority-bars{display:flex;flex-direction:column;gap:1rem}
.pb-row{display:flex;align-items:center;gap:1rem}
.pb-label{font-family:var(--mono);font-size:0.68rem;letter-spacing:0.08em;text-transform:uppercase;width:5rem;color:var(--muted)}
.pb-track{flex:1;height:8px;background:var(--rule);position:relative}
.pb-fill{height:100%;background:var(--ink);transition:width 0.6s cubic-bezier(0.4,0,0.2,1);width:0}
.pb-fill.med{background:var(--muted)}
.pb-fill.low{background:var(--dim)}
.pb-count{font-family:var(--mono);font-size:0.72rem;color:var(--muted);width:1.5rem;text-align:right}

.cat-stats-list{display:flex;flex-direction:column;gap:0.5rem}
.cs-row{
  display:flex;align-items:center;justify-content:space-between;
  padding:0.7rem 1rem;border:1px solid var(--rule);
  transition:background 0.15s;
}
.cs-row:hover{background:var(--lift)}
.cs-name{font-size:0.85rem}
.cs-count{font-family:var(--mono);font-size:0.72rem;color:var(--muted)}

/* ═══════════════════════════════════════════
   ABOUT SECTION
═══════════════════════════════════════════ */
.about-section{padding:5rem 4rem;border-bottom:1px solid var(--rule)}
.about-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:3rem}
.about-col{}
.about-col-title{font-family:var(--serif);font-size:1.3rem;font-weight:700;margin-bottom:1rem}
.about-col p{font-size:0.88rem;color:var(--muted);line-height:1.8;margin-bottom:0.75rem}
.formula-box{
  margin-top:1.25rem;background:var(--ink);color:var(--paper);
  padding:1.25rem;font-family:var(--mono);font-size:0.82rem;line-height:1.7;
}
.formula-comment{color:#888}

/* ═══════════════════════════════════════════
   FOOTER
═══════════════════════════════════════════ */
